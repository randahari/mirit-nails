rules_version = '2';

// ============================================================================
// LIVE IN PRODUCTION since 2026-08-24 (Checkpoint 2). Replaced the previous
// fully-open rules:
//   match /{document=**} { allow read, write: if true; }
// Verified post-deployment: 7/7 automated security checks against real
// production Firestore (all correctly denied, zero data modified), plus a
// manual positive-write pass by the user and Mirit through the live app
// (customer booking + Mirit admin actions, confirmed working end to end).
// This file itself was only added to the `main` branch afterward, to close
// the gap between what's deployed and what's tracked in git — the rules
// text is unchanged from what passed 20/20 in test/firestore.rules.test.js.
//
// Scoped narrowly to what the Invoice4U receipt project requires:
//   - block ALL client writes to the new `payment` / `receipt` fields on
//     appointments (only the Cloud Function, via the Admin SDK — which
//     bypasses these rules entirely — may write them)
//   - block ALL client access to the new `config/*` collection
//   - require an authenticated admin (Firebase Auth + admin custom claim)
//     to write `blocked_slots` / `availability`, and to delete appointments
//
// Deliberately NOT changed: unauthenticated customers can still create
// appointments and update non-financial fields on any appointment (e.g.
// self-service cancel). That is today's existing behavior, preserved as-is
// — closing it requires real customer identity, which is a separate,
// explicitly deferred decision (see investigation doc, open question #10).
//
// Verified against 8 required flows via @firebase/rules-unit-testing —
// see test/firestore.rules.test.js and the verification evidence report.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /appointments/{apptId} {
      // Anyone can read — matches today's behavior. Real customer-scoped
      // read isolation is out of scope for this project (open question #10).
      allow read: if true;

      // Anyone can create a booking — the existing unauthenticated customer
      // booking flow must keep working exactly as it does today.
      allow create: if true;

      // Anyone can update EXCEPT the financial fields, and EXCEPT `name`
      // (2026-08-24, customer-name-edit feature): `name` now feeds a real
      // Invoice4U accounting document, so changing it requires an
      // authenticated admin — unlike every other non-financial field here,
      // which still follows the existing, deliberately permissive model
      // (see header comment). This preserves the existing customer
      // self-cancel flow (which only ever touches `status`) and Mirit's
      // reschedule/edit flow (services/datetime/note), while making
      // `payment`, `receipt`, and now `name` untouchable except by an
      // admin (payment/receipt: server-only, via the Admin SDK, which
      // bypasses these rules entirely).
      //
      // `datetime` post-issuance immutability (2026-09, past-appointment
      // receipt-recovery feature): once receipt.status is already 'issued'
      // (the pre-write state — resource.data, never request.resource.data,
      // which would let the write itself smuggle a fresh status through),
      // `datetime` can no longer be changed by any client write. An issued
      // Invoice4U document's ExternalComments permanently references this
      // appointment's datetime — it must never later disagree with what
      // Firestore says happened. Deliberately NOT a blanket "no editing
      // past appointments" rule: an appointment with no receipt field yet,
      // or one whose last attempt failed, remains fully editable, so
      // ordinary future rescheduling and forgotten-receipt recovery (fixing
      // a wrong date before finally issuing) both keep working exactly as
      // before. `.get(field, default)` is required here, not dot-access —
      // most appointments have no `receipt` field at all, and Rules throw
      // on missing-key dot-access rather than returning null.
      allow update: if !request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(['payment', 'receipt'])
                    && (!request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(['name']) || isAdmin())
                    && (!request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(['datetime'])
                        || resource.data.get('receipt', {}).get('status', null) != 'issued');

      // Deletion (not used by any current flow) is admin-only.
      allow delete: if isAdmin();
    }

    match /blocked_slots/{id} {
      // Read must stay open — the customer-side availability computation
      // reads this collection directly.
      allow read: if true;
      // No legitimate customer scenario ever writes here.
      allow write: if isAdmin();
    }

    match /availability/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // New collection for this project. Never touched by any client SDK —
    // only Cloud Functions (Admin SDK, which bypasses these rules) read it.
    match /config/{doc} {
      allow read, write: if false;
    }
  }
}
