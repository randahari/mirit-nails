{
  "name": "mirit-nails",
  "private": true,
  "description": "Dev-only tooling for this repo (Firestore Rules verification, emulator-driven Auth testing). The app itself remains a build-free static site — this file does not introduce a build step for index.html.",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-admin": "^12.7.0"
  },
  "scripts": {
    "test:rules": "node --test test/firestore.rules.test.js",
    "test:receipt": "node --test --test-concurrency=1 test/issueReceipt.test.js",
    "test:receiptstate": "node --test test/receiptState.test.js",
    "test:gate": "node --test --test-concurrency=1 test/receiptIssuanceGate.test.js",
    "test:nameedit": "node --test --test-concurrency=1 test/customerNameEdit.test.js",
    "test:apptquery": "node --test --test-concurrency=1 test/miritApptsQuery.test.js"
  }
}
