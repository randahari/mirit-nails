# Deploy-time configuration for the "mirit-nails" Firebase project specifically
# (Cloud Functions v2 loads this file automatically only when deploying to a
# project with this exact ID — see https://firebase.google.com/docs/functions/config-env).
# Contains no secrets — just the environment selector. The actual API token
# lives only in Secret Manager (INVOICE4U_API_TOKEN_PRODUCTION).

INVOICE4U_ENVIRONMENT=production

# B4B (2026-08-24): opened after full preflight passed (51/51 tests across
# all suites; see B4B completion report). issueReceipt can now actually
# reach Invoice4U — production, real documents, real legal consequence.
# This is the ONLY place this can be flipped — never Firestore, never any
# client code, never reachable without a deliberate code change + redeploy.
RECEIPT_ISSUANCE_ENABLED=true
